{
  "name": "gz-agent",
  "version": "0.1.0",
  "description": "Production-grade agent runtime for AI systems — tool calling, state machines, memory, and multi-agent coordination.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gz-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch --forceExit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "runtime",
    "orchestration",
    "tool-calling",
    "multi-agent",
    "llm",
    "openai",
    "state-machine"
  ],
  "author": "Ground Zero LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oke3/gz-agent"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
